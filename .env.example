# Vercel Blob — create a store at vercel.com/dashboard → Storage → Blob
# then copy the read/write token here
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# Google Apps Script contact form endpoint
# See apps-script/Code.gs for setup instructions
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
